}

.year {
  font-size: 48px;
  font-weight: bold;
  color: #00e5ff;
  text-shadow: 0 0 15px rgba(0, 229, 255, 0.6);
}

.card h2 {
  font-size: 22px;
  margin: 15px 0;
}

.card p {
  color: #c8c8d8;
  min-height: 45px;
}

.button {
  display: inline-block;
  margin-top: 18px;
  padding: 13px 24px;
  border-radius: 30px;
  background: #00e5ff;
  color: #050509;
  text-decoration: none;
  font-weight: bold;
  transition: 0.3s;
}

.button:hover {
  background: white;
  transform: scale(1.05);
}

footer {
  text-align: center;
  margin-top: 55px;
  color: #9999aa;
  font-size: 14px;
}

@media (max-width: 800px) {
  .cards {
    grid-template-columns: 1fr;
  }

  .logo {
    font-size: 29px;
  }
}
</style>
</head>

